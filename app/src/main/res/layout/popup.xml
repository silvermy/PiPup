<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent" android:id="@+id/popup_frame"
            android:paddingBottom="3dp"
            android:paddingTop="3dp">
    </FrameLayout>
    <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/popup_title"
            android:textSize="30sp"
            android:textStyle="bold"
            android:gravity="center_vertical"/>
    <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/popup_message" android:textSize="24sp"
    />
    <!-- Empties left-to-right over the popup's duration. Hidden unless asked for. -->
    <!-- wrap_content so it measures to zero and cannot widen the card; its real
         width is set in code once the card has been measured. -->
    <View
            android:layout_width="wrap_content"
            android:layout_height="4dp"
            android:id="@+id/popup_progress"
            android:layout_marginTop="8dp"
            android:visibility="gone"/>
</merge>
